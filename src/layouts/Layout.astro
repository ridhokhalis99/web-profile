---
import "../styles/global.css";
import socialLinks from "../data/socialLinks";

export interface Props {
  title: string;
  description?: string;
  current?: "work" | "start";
  cta?: string;
}

const {
  title,
  description = "Ridho Khalis is a backend engineer at Transfez and founder of Erkabased. He helps businesses turn ideas into software that keeps running.",
  current,
  cta = "Got a project?",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/assets/images/profile.webp", Astro.site);
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ridho Khalis",
  url: Astro.site?.href,
  image: ogImage.href,
  jobTitle: "Software Engineer",
  worksFor: { "@type": "Organization", name: "Transfez" },
  sameAs: socialLinks.map((link) => link.href),
};

const navLinks = [
  { name: "Work", href: "/#work", key: "work" },
  { name: "Writing & videos", href: "/#notes" },
  { name: "About", href: "/#about" },
];
const fonts =
  "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500..800&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Kalam:wght@400;700&display=swap";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f5f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121419" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ridho Khalis" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fonts} /></noscript>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <!-- Google tag (gtag.js) -->
    <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-4BZ8M3LS6R"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-4BZ8M3LS6R");
    </script>
  </head>
  <body>
    <!-- Shared marker filter and arrowhead for every hand-drawn diagram -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="rough" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="4" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <marker id="head" viewBox="0 0 12 12" refX="9" refY="6" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
          <path d="M1 1.5 L10 6 L1 10.5" fill="none" stroke="context-stroke" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </marker>
      </defs>
    </svg>

    <header class="nav">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label="Ridho Khalis, home">Ridho Khalis
          <svg viewBox="0 0 120 8" preserveAspectRatio="none" aria-hidden="true"><path class="d-marker" d="M2 5 C 30 2, 70 7, 118 3" /></svg>
        </a>
        <nav class="nav-links" aria-label="Main">
          {navLinks.map((l) => <a href={l.href} aria-current={current && current === l.key ? "page" : undefined}>{l.name}</a>)}
          <a class="nav-resume" href="/resume.pdf" target="_blank" rel="noopener">Résumé</a>
          <a class="btn" href="/start" aria-current={current === "start" ? "page" : undefined}>Start a project</a>
          <details class="menu">
            <summary aria-label="Menu">
              <svg class="i-open" viewBox="0 0 24 24" aria-hidden="true"><g class="rough"><path class="d-stroke" d="M3 6.5 C 9 5.5, 15 7, 21 6M3 12.2 C 9 11.6, 15 12.8, 21 11.8M3 17.8 C 9 17.2, 15 18.4, 21 17.5" /></g></svg>
              <svg class="i-close" viewBox="0 0 24 24" aria-hidden="true"><g class="rough"><path class="d-marker" d="M5 5 C 10 10, 14 14, 19 19M19 5 C 14 10, 10 14, 5 19" /></g></svg>
            </summary>
            <ul>
              {navLinks.map((l) => <li><a href={l.href}>{l.name}</a></li>)}
              <li><a href="/resume.pdf">Résumé</a></li>
            </ul>
          </details>
        </nav>
      </div>
    </header>

    <slot />

    {
      current !== "start" && (
        <section class="cta-band">
          <div class="wrap">
            <h2>
              {cta} Let's{" "}
              <span class="circled">
                sketch it
                <svg viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden="true">
                  <path class="d-marker draw" style="--len:520;--d:.2s" d="M30 12 C 90 -2, 190 6, 194 38 C 198 70, 70 82, 18 64 C -6 54, 6 18, 56 10" />
                </svg>
              </span>{" "}
              out.
            </h2>
            <div class="cta-side">
              <p class="muted">Tell me what you're building and where you're stuck. We'll take it from there.</p>
              <a class="btn" href="/start">Start a project</a>
              <div class="email-card">
                <span class="hand">or just email me</span>
                <a class="email-addr" href="mailto:ridhokhalis37@gmail.com">ridhokhalis37@gmail.com</a>
                <button class="copy" type="button" data-copy="ridhokhalis37@gmail.com">Copy email</button>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <footer class="footer">
      <div class="wrap">
        <div class="f-brand">
          <span class="wordmark">Ridho Khalis</span>
          <span class="muted">Turning ideas into running products, one sketch at a time.</span>
          <span class="muted">© {new Date().getFullYear()}</span>
        </div>
        <div>
          <h4>Site</h4>
          <ul>
            {navLinks.map((l) => <li><a href={l.href}>{l.name}</a></li>)}
            <li><a href="/start">Start a project</a></li>
            <li><a href="/resume.pdf">Résumé</a></li>
          </ul>
        </div>
        <div>
          <h4>Elsewhere</h4>
          <ul>
            {socialLinks.map((l) => <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.name}</a></li>)}
          </ul>
        </div>
      </div>
    </footer>

    <script>
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) =>
        b.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(b.dataset.copy!);
            b.textContent = "Copied";
          } catch {
            b.textContent = "Select and copy";
          }
          setTimeout(() => (b.textContent = "Copy email"), 2000);
        }),
      );
      // Close the mobile menu after a link is chosen (same-page anchors keep <details> open otherwise).
      document.querySelectorAll(".menu a").forEach((a) =>
        a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")),
      );
    </script>
  </body>
</html>
