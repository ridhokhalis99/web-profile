---
import Layout from "../../layouts/Layout.astro";

const features = [
  ["Offline-capable cashier.", "A PWA wrapped with Capacitor, so sales keep going without internet."],
  ["Stock and recipes.", "Cost per portion comes from the latest purchase prices."],
  ["Delivery reports.", "GoFood, GrabFood and ShopeeFood exports become transactions with profit per channel."],
  ["Storefront and invoices.", "An online store, plus invoices with installments."],
  ["Modules per business type.", "Chosen at sign-up, so a café and a catering business see different tools."],
];
const stack = [
  ["Next.js", "Back office and storefront"],
  ["NestJS", "One API for every client, with modules per business type"],
  ["PostgreSQL + Drizzle", "Stock, recipes and money need strict consistency"],
  ["BullMQ + Redis", "Report imports run in the background, not in a request"],
  ["Capacitor", "The same cashier code ships as a phone app"],
  ["Docker", "Every service deploys the same way"],
];
---

<Layout
  title="Rekanka · Ridho Khalis"
  description="Rekanka runs an Indonesian small business from one app: offline cashier, stock and recipes, delivery-platform reports and profit per channel."
  current="work"
  cta="Need something like this?"
>
  <main class="wrap">
    <p class="crumbs"><a href="/#work">Work</a> / Rekanka</p>
    <div class="cs-hero">
      <div>
        <h1>Rekanka</h1>
        <p class="lede">Runs an Indonesian small business from one app, from the cashier to the profit report.</p>
      </div>
      <dl class="facts">
        <div><dt>Status</dt><dd>Live</dd></div>
        <div><dt>Built with</dt><dd>Erkabased</dd></div>
        <div class="full"><dt>Link</dt><dd><a class="link-arrow" href="https://rekanka-app.erkabased.com" target="_blank" rel="noopener noreferrer">rekanka-app.erkabased.com</a></dd></div>
      </dl>
    </div>

    <div class="board-big">
      <svg viewBox="0 0 1000 470" role="img" aria-label="Rekanka system: cashier, back office and storefront clients; NestJS API; PostgreSQL; BullMQ and Redis jobs that import GoFood, GrabFood and ShopeeFood reports; S3 file storage.">
        <g class="rough">
          <rect class="d-fill d-stroke" x="20" y="40" width="200" height="74" rx="9" />
          <rect class="d-fill d-stroke" x="20" y="150" width="200" height="74" rx="9" />
          <rect class="d-fill d-stroke" x="20" y="260" width="200" height="74" rx="9" />
          <rect class="d-wash" x="350" y="120" width="250" height="150" rx="12" />
          <rect class="d-stroke" x="350" y="120" width="250" height="150" rx="12" />
          <path class="d-fill d-stroke" d="M760 120 v 96 c 0 16, 200 16, 200 0 v -96" />
          <ellipse class="d-fill d-stroke" cx="860" cy="120" rx="100" ry="16" />
          <rect class="d-fill d-stroke" x="350" y="350" width="250" height="80" rx="9" />
          <rect class="d-fill d-stroke" x="760" y="350" width="200" height="80" rx="9" />
          <rect class="d-fill d-stroke" x="20" y="380" width="200" height="60" rx="9" stroke-dasharray="6 7" />
          <path class="d-stroke" marker-end="url(#head)" d="M220 77 C 280 80, 300 140, 344 160" />
          <path class="d-stroke" marker-end="url(#head)" d="M220 187 L 344 190" />
          <path class="d-stroke" marker-end="url(#head)" d="M220 297 C 280 294, 300 240, 344 226" />
          <path class="d-stroke" marker-end="url(#head)" d="M600 190 L 754 176" />
          <path class="d-stroke" marker-end="url(#head)" d="M475 270 L 475 344" />
          <path class="d-stroke" marker-end="url(#head)" d="M600 390 L 754 390" />
          <path class="d-stroke" marker-end="url(#head)" d="M220 410 C 270 410, 300 400, 344 394" />
          <path class="d-stroke" marker-end="url(#head)" d="M560 350 C 640 300, 720 260, 790 236" />
        </g>
        <text class="d-text" x="40" y="74" font-size="20">Cashier</text><text class="d-mono" x="40" y="98" font-size="13">PWA + Capacitor</text>
        <text class="d-text" x="40" y="184" font-size="20">Back office</text><text class="d-mono" x="40" y="208" font-size="13">Next.js</text>
        <text class="d-text" x="40" y="294" font-size="20">Storefront</text><text class="d-mono" x="40" y="318" font-size="13">online orders</text>
        <text class="d-text" x="372" y="162" font-size="24">API</text><text class="d-mono" x="372" y="188" font-size="13">NestJS · modules per</text><text class="d-mono" x="372" y="206" font-size="13">business type</text>
        <text class="d-text" x="790" y="170" font-size="20">PostgreSQL</text><text class="d-mono" x="790" y="194" font-size="13">Drizzle</text>
        <text class="d-text" x="372" y="384" font-size="20">Background jobs</text><text class="d-mono" x="372" y="408" font-size="13">BullMQ + Redis</text>
        <text class="d-text" x="780" y="384" font-size="20">Files</text><text class="d-mono" x="780" y="408" font-size="13">S3</text>
        <text class="d-text" x="40" y="407" font-size="17">Delivery reports</text><text class="d-mono" x="40" y="427" font-size="12">GoFood · Grab · Shopee</text>
        <text class="d-hand" x="236" y="30" font-size="20">keeps selling when the wifi drops</text>
        <g class="rough"><path class="d-marker" marker-end="url(#head)" d="M232 36 C 214 44, 206 50, 200 54" /></g>
        <text class="d-hand" x="700" y="326" font-size="20">profit per channel</text>
        <text class="d-hand" x="630" y="80" font-size="20">cost per portion from latest prices</text>
        <g class="rough"><path class="d-marker" marker-end="url(#head)" d="M760 88 C 774 96, 780 104, 782 110" /></g>
      </svg>
    </div>
    <p class="hand scroll-hint">swipe the diagram →</p>

    <div class="cs-body">
      <nav class="toc" aria-label="On this page">
        <a href="#problem">The problem</a>
        <a href="#what">What it does</a>
        <a href="#how">How it's built</a>
      </nav>
      <div class="prose">
        <section id="problem">
          <h2>The problem</h2>
          <p>A small food business in Indonesia often runs on a cashier app, a spreadsheet for stock, and three delivery-platform dashboards that never agree. The owner can't see what one portion really costs, or which channel actually makes money.</p>
        </section>
        <section id="what">
          <h2>What it does</h2>
          <ul class="feature-list">
            {
              features.map(([b, t]) => (
                <li>
                  <svg viewBox="0 0 22 22" aria-hidden="true"><path class="d-marker" d="M4 11.5l4 4 10-10" /></svg>
                  <span><b>{b}</b> {t}</span>
                </li>
              ))
            }
          </ul>
        </section>
        <section id="how">
          <h2>How it's built</h2>
          <div class="table-wrap">
            <table class="why">
              <tbody>{stack.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}</tbody>
            </table>
          </div>
        </section>
      </div>
    </div>

    <div class="next">
      <a href="/#work"><span><span class="muted small">Back to</span><h2>All work</h2></span>
        <svg width="56" height="56" viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" fill="none" stroke="var(--marker)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
    </div>
  </main>
</Layout>

<style>
  .crumbs { font-size: var(--step--1); color: var(--ink-2); padding-top: 40px; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--marker); }
  .cs-hero { padding-block: 20px 48px; display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: end; }
  .cs-hero h1 { font-size: clamp(3rem, 2rem + 5vw, 6rem); }
  .cs-hero .lede { max-width: 30ch; margin-top: 18px; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; margin: 0; border-top: 1.5px solid var(--ink); }
  .facts div { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .facts .full { grid-column: 1 / -1; }
  .facts dt { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); font-weight: 600; }
  .facts dd { margin: 4px 0 0; font-weight: 600; }
  @media (max-width: 820px) { .cs-hero { grid-template-columns: 1fr; gap: 28px; } }

  .board-big { border: 1.5px solid var(--ink); border-radius: 16px; background: var(--board); padding: clamp(16px, 3vw, 40px); overflow-x: auto; box-shadow: 0 24px 50px -34px rgba(21, 23, 28, 0.4); }
  .board-big svg { width: 100%; min-width: 720px; height: auto; }
  .scroll-hint { display: none; margin-top: 10px; }
  @media (max-width: 760px) { .scroll-hint { display: block; } }

  .cs-body { display: grid; grid-template-columns: 220px 1fr; gap: clamp(32px, 6vw, 96px); padding-block: clamp(64px, 8vw, 112px); }
  .toc { position: sticky; top: 96px; align-self: start; display: grid; gap: 10px; font-size: var(--step--1); }
  .toc a { text-decoration: none; color: var(--ink-2); padding-left: 14px; border-left: 2px solid var(--line); }
  .toc a:hover { color: var(--ink); border-left-color: var(--marker); }
  .prose { display: grid; gap: 56px; max-width: 68ch; }
  .prose section { display: grid; gap: 16px; scroll-margin-top: 90px; }
  .prose p { color: var(--ink-2); }
  .feature-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .feature-list li { display: grid; grid-template-columns: 28px 1fr; gap: 12px; padding: 14px 0; border-top: 1px dashed var(--line); }
  .feature-list b { color: var(--ink); font-weight: 600; }
  .feature-list svg { width: 22px; height: 22px; margin-top: 3px; }
  .table-wrap { overflow-x: auto; }
  .why { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .why th, .why td { text-align: left; padding: 12px 10px 12px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .why th { font-family: var(--mono); font-weight: 500; font-size: 0.82rem; white-space: nowrap; color: var(--ink); }
  .why td { color: var(--ink-2); }
  @media (max-width: 820px) { .cs-body { grid-template-columns: 1fr; } .toc { display: none; } }

  .next { border-top: 1px dashed var(--line); padding-block: 48px; }
  .next a { display: flex; justify-content: space-between; align-items: center; gap: 20px; text-decoration: none; }
  .next a:hover h2 { color: var(--marker); }
  .small { font-size: var(--step--1); }
</style>
